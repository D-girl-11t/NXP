/*
 * FRDM-i.MX93 + Arducam IMX519, for linux-imx lf-6.18.2-1.0.0
 * (hostname imx93-11x11-lpddr4x-frdm, uname 6.18.2-1.0.0-g*).
 *
 * Replaces the stock AP1302 MiniSAS camera. Needs an RPi-CAM to MiniSAS adapter.
 *
 * Boot:
 *   setenv fdtfile imx93-11x11-frdm-imx519.dtb
 */
#include "imx93-11x11-frdm.dts"

/ {
	model = "NXP FRDM-i.MX93 with Arducam IMX519";
	compatible = "fsl,imx93-11x11-frdm-imx519", "fsl,imx93-11x11-frdm",
		     "fsl,imx93";

	reg_imx519_vdig: regulator-imx519-vdig {
		compatible = "regulator-fixed";
		regulator-name = "imx519_vdig";
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
		regulator-always-on;
	};
};

/* 6.18 CSI graph: imx519 -> mipi_csi_in -> mipi_csi_out -> isi_in */
&mipi_csi_in {
	remote-endpoint = <&imx519_ep>;
	data-lanes = <1 2>;
	clock-lanes = <0>;
};

&lpi2c3 {
	/delete-node/ ap1302_mipi@3c;

	imx519: imx519@1a {
		compatible = "sony,imx519";
		reg = <0x1a>;
		status = "okay";

		clocks = <&clk IMX93_CLK_24M>;
		clock-names = "xclk";

		/* Same CAM reset GPIO the 6.18 FRDM DTS uses for AP1302. */
		reset-gpios = <&pcal6524 22 GPIO_ACTIVE_LOW>;

		VANA-supply = <&reg_avdd_2v8>;
		VDIG-supply = <&reg_imx519_vdig>;
		VDDL-supply = <&reg_vddio_1v8>;

		rotation = <0>;
		orientation = <2>;
		lens-focus = <&ak7375>;

		port {
			imx519_ep: endpoint {
				remote-endpoint = <&mipi_csi_in>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <408000000>;
			};
		};
	};

	ak7375: ak7375@c {
		compatible = "asahi-kasei,ak7375";
		reg = <0x0c>;
		status = "okay";
		vdd-supply = <&reg_avdd_2v8>;
	};
};
