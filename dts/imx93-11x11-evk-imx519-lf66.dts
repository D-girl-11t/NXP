// SPDX-License-Identifier: GPL-2.0
/*
 * i.MX93 11x11 EVK + Arducam IMX519, for linux-imx lf-6.1 / lf-6.6.
 *
 * REFERENCE ONLY, NEVER TESTED. This project was brought up on FRDM-i.MX93
 * running linux-imx 6.18.2; see imx93-11x11-frdm-imx519.dts.
 *
 * Those BSPs expose the capture path as isi_0 + cameradev + mipi_csi, and the
 * CSI-2 PHY rates come from hs-clk-range / cfg-clk-range in the device tree.
 * From lf-6.12 the graph is mipi_csi_in / mipi_csi_out / isi_in and the PHY is
 * programmed from V4L2_CID_LINK_FREQ instead, so use
 * imx93-11x11-evk-imx519.dts there.
 *
 * install-into-kernel.sh detects which of the two a kernel tree needs and
 * copies the right one as imx93-11x11-evk-imx519.dts.
 *
 * Boot:
 *   setenv fdtfile imx93-11x11-evk-imx519.dtb
 */
#include "imx93-11x11-evk.dts"

/ {
	model = "NXP i.MX93 11x11 EVK with Arducam IMX519";
	compatible = "fsl,imx93-11x11-evk-imx519", "fsl,imx93-11x11-evk",
		     "fsl,imx93";

	/*
	 * lf-6.6 has no IMX93_CLK_24M consumer binding for this node, so feed
	 * the sensor a fixed-clock description of the 24 MHz CAM_MCLK the
	 * connector already supplies.
	 */
	clk_imx519_24m: clock-imx519-24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "imx519_xclk";
	};

	/*
	 * The Arducam B0371 regulates its own rails from the 3.3 V the camera
	 * connector supplies, so model all three as always-on fixed regulators.
	 *
	 * Do not reuse the stock reg_avdd_2v8 / reg_vddio_1v8: those are gated
	 * by an ADP5585 I/O expander that belongs to NXP's camera module. With
	 * that module absent the expander never probes and the sensor is stuck
	 * in deferred probe ("supplier regulator-vddo not ready").
	 */
	reg_imx519_vana: regulator-imx519-vana {
		compatible = "regulator-fixed";
		regulator-name = "imx519_vana";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-always-on;
	};

	reg_imx519_vdig: regulator-imx519-vdig {
		compatible = "regulator-fixed";
		regulator-name = "imx519_vdig";
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
		regulator-always-on;
	};

	reg_imx519_vddl: regulator-imx519-vddl {
		compatible = "regulator-fixed";
		regulator-name = "imx519_vddl";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
};

&isi_0 {
	status = "okay";

	cap_device {
		status = "okay";
	};
};

&cameradev {
	status = "okay";
};

&mipi_csi {
	status = "okay";

	port {
		mipi_csi_ep: endpoint {
			remote-endpoint = <&imx519_ep>;

			/* Lane count on this binding, not a lane list. */
			data-lanes = <2>;

			/* 24 MHz CFGCLK encoding, as used by the stock AP1302. */
			cfg-clk-range = <28>;

			/*
			 * 816 Mbps/lane for the 408 MHz link. The stock AP1302
			 * value 0x2b is 1300 Mbps and will not lock this sensor.
			 */
			hs-clk-range = <0x19>;

			/* V4L2_FWNODE_BUS_TYPE_CSI2_DPHY */
			bus-type = <4>;
		};
	};
};

&lpi2c3 {
	/delete-node/ ap1302_mipi@3c;

	imx519: imx519@1a {
		compatible = "sony,imx519";
		reg = <0x1a>;
		status = "okay";

		clocks = <&clk_imx519_24m>;
		clock-names = "xclk";

		/* XCLR, on the expander line the AP1302 used for reset. */
		reset-gpios = <&adp5585gpio 0 GPIO_ACTIVE_LOW>;

		VANA-supply = <&reg_imx519_vana>;
		VDIG-supply = <&reg_imx519_vdig>;
		VDDL-supply = <&reg_imx519_vddl>;

		rotation = <0>;
		orientation = <2>;
		lens-focus = <&ak7375>;

		port {
			imx519_ep: endpoint {
				remote-endpoint = <&mipi_csi_ep>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <408000000>;
			};
		};
	};

	ak7375: ak7375@c {
		compatible = "asahi-kasei,ak7375";
		reg = <0x0c>;
		status = "okay";
		vdd-supply = <&reg_imx519_vana>;
	};
};
