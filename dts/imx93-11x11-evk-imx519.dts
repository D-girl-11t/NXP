// SPDX-License-Identifier: GPL-2.0
/*
 * i.MX93 11x11 EVK + Arducam IMX519, linux-imx lf-6.12 / lf-6.18.
 *
 * Replaces AP1302 on the MiniSAS CSI connector (J801). Needs an
 * RPi-CAM-to-MiniSAS adapter; the socket is not a Pi camera socket.
 *
 * For lf-6.1 / lf-6.6, use imx93-11x11-evk-imx519-lf66.dts instead: the
 * CSI graph labels differ (isi_0 / cameradev rather than mipi_csi_in).
 *
 * Boot:
 *   setenv fdtfile imx93-11x11-evk-imx519.dtb
 */
#include "imx93-11x11-evk.dts"

/ {
	model = "NXP i.MX93 11x11 EVK with Arducam IMX519";
	compatible = "fsl,imx93-11x11-evk-imx519", "fsl,imx93-11x11-evk",
		     "fsl,imx93";

	/*
	 * The Arducam B0371 regulates its own rails from the 3.3 V the camera
	 * connector supplies, so model all three as always-on fixed regulators.
	 *
	 * Do not reuse the stock reg_avdd_2v8 / reg_vddio_1v8: those are gated
	 * by an ADP5585 I/O expander that belongs to NXP's camera module. With
	 * that module absent the expander never probes and the sensor is stuck
	 * in deferred probe ("supplier regulator-vddo not ready").
	 */
	reg_imx519_vana: regulator-imx519-vana {
		compatible = "regulator-fixed";
		regulator-name = "imx519_vana";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-always-on;
	};

	reg_imx519_vdig: regulator-imx519-vdig {
		compatible = "regulator-fixed";
		regulator-name = "imx519_vdig";
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
		regulator-always-on;
	};

	reg_imx519_vddl: regulator-imx519-vddl {
		compatible = "regulator-fixed";
		regulator-name = "imx519_vddl";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
};

/* 6.12+ CSI graph: imx519 -> mipi_csi_in -> mipi_csi_out -> isi_in */
&mipi_csi_in {
	remote-endpoint = <&imx519_ep>;
	data-lanes = <1 2>;
	clock-lanes = <0>;
};

&lpi2c3 {
	/delete-node/ ap1302_mipi@3c;

	imx519: imx519@1a {
		compatible = "sony,imx519";
		reg = <0x1a>;
		status = "okay";

		clocks = <&clk IMX93_CLK_24M>;
		clock-names = "xclk";

		/* XCLR, on the same expander line the AP1302 used for reset. */
		reset-gpios = <&adp5585 0 GPIO_ACTIVE_LOW>;

		VANA-supply = <&reg_imx519_vana>;
		VDIG-supply = <&reg_imx519_vdig>;
		VDDL-supply = <&reg_imx519_vddl>;

		rotation = <0>;
		orientation = <2>;
		lens-focus = <&ak7375>;

		port {
			imx519_ep: endpoint {
				remote-endpoint = <&mipi_csi_in>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <408000000>;
			};
		};
	};

	ak7375: ak7375@c {
		compatible = "asahi-kasei,ak7375";
		reg = <0x0c>;
		status = "okay";
		vdd-supply = <&reg_imx519_vana>;
	};
};
